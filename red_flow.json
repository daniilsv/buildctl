    {
        "id": "56c854cbb296cee5",
        "type": "function",
        "z": "3ab73f752ddcb6a1",
        "name": "filter commits",
        "func": "let commits = [];\nconst startHash = msg.initial_payload.start_hash;\nconst endHash = msg.initial_payload.end_hash;\n\nconst newCommits = msg.payload;\nlet foundStart = false;\nfor (let commit of newCommits) {\n    if(commit.sha == startHash){\n        foundStart=true;\n    }\n    if(foundStart)\n        commits.push({\n            sha: commit.sha,\n            message: commit.commit.message,\n            author: commit.commit.author.name,\n            date: commit.commit.author.date\n        });\n\n    if (commit.sha == endHash) {\n        break;\n    }\n}\nmsg.commits = commits;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
