{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/back/cmd/server",
      "env": {
        "DATABASE_URL": "${env:DATABASE_URL}",
        "PORT": "${env:PORT}",
        "OIDC_ISSUER": "${env:OIDC_ISSUER}",
        "OIDC_CLIENT_ID": "${env:OIDC_CLIENT_ID}",
        "OIDC_CLIENT_SECRET": "${env:OIDC_CLIENT_SECRET}",
        "OIDC_REDIRECT_URL": "${env:OIDC_REDIRECT_URL}",
        "OPENAI_API_URL": "${env:OPENAI_API_URL}",
        "OPENAI_API_KEY": "${env:OPENAI_API_KEY}",
        "OPENAI_MODEL": "${env:OPENAI_MODEL}",
        "S3_ENDPOINT": "${env:S3_ENDPOINT}",
        "S3_REGION": "${env:S3_REGION}",
        "S3_PATH_STYLE": "${env:S3_PATH_STYLE}",
        "S3_BUCKET": "${env:S3_BUCKET}",
        "S3_ACCESS_KEY": "${env:S3_ACCESS_KEY}",
        "S3_SECRET_KEY": "${env:S3_SECRET_KEY}",
        "S3_PUBLIC_PREFIX": "${env:S3_PUBLIC_PREFIX}",
        "TELEGRAM_BOT_TOKEN": "${env:TELEGRAM_BOT_TOKEN}",
        "WORKER_POOL_SIZE": "${env:WORKER_POOL_SIZE}"
      },
      "args": [],
      "showLog": true,
      "cwd": "${workspaceFolder}/back"
    },
    {
      "name": "Backend Server (with .env)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/back/cmd/server",
      "envFile": "${workspaceFolder}/back/.env",
      "args": [],
      "showLog": true,
      "cwd": "${workspaceFolder}/back"
    },
    {
      "name": "CLI: Event",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cli/cmd/buildctl",
      "args": [
        "event",
        "--token=${input:cliToken}",
        "--backend=${input:cliBackend}",
        "--project-id=${input:projectId}",
        "--commit=${input:commitHash}",
        "--branch=${input:branch}",
        "--status=${input:status}",
        "--log=${input:logMessage}"
      ],
      "cwd": "${workspaceFolder}/cli"
    },
    {
      "name": "CLI: Artifact Upload",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cli/cmd/buildctl",
      "args": [
        "artifact",
        "upload",
        "--token=${input:cliToken}",
        "--backend=${input:cliBackend}",
        "--build-id=${input:buildId}",
        "--file=${input:filePath}"
      ],
      "cwd": "${workspaceFolder}/cli"
    },
    {
      "name": "Attach to Backend",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": 0
    },
    {
      "name": "Frontend Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/front",
      "serverReadyAction": {
        "pattern": "Local:.*(https?://.*)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Frontend + Backend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/front",
      "serverReadyAction": {
        "pattern": "Local:.*(https?://.*)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "go: build backend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": [
        "Backend Server (with .env)",
        "Frontend Dev Server"
      ],
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      },
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "cliToken",
      "type": "promptString",
      "description": "CLI Token"
    },
    {
      "id": "cliBackend",
      "type": "promptString",
      "description": "Backend URL",
      "default": "http://localhost:8080"
    },
    {
      "id": "projectId",
      "type": "promptString",
      "description": "Project ID (UUID)"
    },
    {
      "id": "commitHash",
      "type": "promptString",
      "description": "Commit Hash"
    },
    {
      "id": "branch",
      "type": "promptString",
      "description": "Branch Name",
      "default": "main"
    },
    {
      "id": "status",
      "type": "pickString",
      "description": "Build Status",
      "options": [
        "queued",
        "started",
        "in_progress",
        "success",
        "failed",
        "cancelled"
      ]
    },
    {
      "id": "logMessage",
      "type": "promptString",
      "description": "Log Message",
      "default": ""
    },
    {
      "id": "buildId",
      "type": "promptString",
      "description": "Build ID (UUID)"
    },
    {
      "id": "filePath",
      "type": "promptString",
      "description": "File Path to Upload"
    }
  ]
}
